DATABASE_URL="postgresql://user:password@localhost:5432/packton?schema=public"
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# SMS notifications (Africa's Talking) — leave blank to no-op with a console log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Mobile money remittance — leave blank to no-op with a console log
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa

# File storage for proof-of-delivery photos/signatures (Cloudflare R2) — leave blank to
# have proof-of-delivery uploads fail with a clear "not configured" error until set
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Outbound email (SMTP, e.g. via nodemailer with any provider — SendGrid, Postmark, Gmail
# app password, etc.) — leave blank to no-op with a console log. Used to send generated
# login credentials (when an admin creates a user) and password reset links.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Packton <no-reply@packton.com>"
